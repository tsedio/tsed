{
  "name": "@tsed/passport",
  "version": "8.17.0",
  "description": "Passport package for Ts.ED framework",
  "source": "./src/index.ts",
  "type": "module",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "tsed-source": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "pnpm run clean && pnpm run barrels && pnpm run build:ts",
    "barrels": "barrels",
    "test": "vitest run",
    "start": "ts-node src/index.ts",
    "build:ts": "tsc --build tsconfig.esm.json",
    "test:ci": "vitest run --coverage.thresholds.autoUpdate=true"
  },
  "dependencies": {
    "tslib": ">=2.7.0"
  },
  "devDependencies": {
    "@tsed/barrels": "workspace:*",
    "@tsed/core": "workspace:*",
    "@tsed/di": "workspace:*",
    "@tsed/exceptions": "workspace:*",
    "@tsed/json-mapper": "workspace:*",
    "@tsed/logger": "^8.0.0",
    "@tsed/platform-http": "workspace:*",
    "@tsed/platform-middlewares": "workspace:*",
    "@tsed/platform-params": "workspace:*",
    "@tsed/platform-router": "workspace:*",
    "@tsed/schema": "workspace:*",
    "@tsed/typescript": "workspace:*",
    "@types/body-parser": "1.19.5",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/express-session": "1.18.1",
    "@types/method-override": "0.0.35",
    "@types/passport": "1.0.16",
    "@types/passport-http": "0.3.11",
    "@types/passport-local": "1.0.38",
    "@types/passport-strategy": "0.2.38",
    "body-parser": "2.4.0",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "express-session": "1.18.1",
    "method-override": "3.0.0",
    "passport": "0.7.0",
    "passport-http": "0.3.0",
    "passport-local": "1.0.0",
    "passport-strategy": "1.0.0",
    "supertest": "7.0.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@tsed/exceptions": ">=8.0.0",
    "@tsed/json-mapper": ">=8.0.0",
    "@tsed/logger": ">=8.0.0",
    "@tsed/platform-http": ">=8.0.0",
    "@tsed/platform-middlewares": ">=8.0.0",
    "@tsed/platform-params": ">=8.0.0",
    "@tsed/schema": ">=8.0.0",
    "passport": ">=0.4.1"
  },
