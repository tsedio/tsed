{
  "name": "@tsed/agenda",
  "version": "8.17.0",
  "description": "Agenda package for Ts.ED framework",
  "contributors": [
    {
      "name": "Oliver Christen"
    }
  ],
  "source": "./src/index.ts",
  "type": "module",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "tsed-source": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run barrels && pnpm run build:ts",
    "barrels": "barrels",
    "test": "vitest run",
    "build:ts": "tsc --build tsconfig.esm.json",
    "test:ci": "vitest run --coverage.thresholds.autoUpdate=true"
  },
  "dependencies": {
    "tslib": ">=2.7.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@agendajs/mongo-backend": "^4.0.2",
    "@tsed/barrels": "workspace:*",
    "@tsed/core": "workspace:*",
    "@tsed/di": "workspace:*",
    "@tsed/hooks": "workspace:*",
    "@tsed/platform-http": "workspace:*",
    "@tsed/testcontainers-mongo": "workspace:*",
    "@tsed/typescript": "workspace:*",
    "@types/body-parser": "1.19.5",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/method-override": "0.0.35",
    "agenda": "^6.2.5",
    "body-parser": "2.2.1",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "method-override": "3.0.0",
    "mongodb": "^6.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@tsed/hooks": ">=8.0.0",
    "agenda": "^6.2.5"
  }
}
