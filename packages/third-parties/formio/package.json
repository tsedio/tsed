{
  "name": "@tsed/formio",
  "version": "8.17.0",
  "description": "Formio package for Ts.ED framework",
  "keywords": [
    "Formio",
    "Ts.ED",
    "TypeScript",
    "decorators",
    "express",
    "tsed"
  ],
  "source": "./src/index.ts",
  "type": "module",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "tsed-source": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run barrels && pnpm run build:ts",
    "barrels": "barrels",
    "start": "ts-node test/app/index.ts",
    "test": "vitest run",
    "build:ts": "tsc --build tsconfig.esm.json",
    "test:ci": "vitest run --coverage.thresholds.autoUpdate=true"
  },
  "dependencies": {
    "@tsed/formio-types": "workspace:*",
    "@tsed/normalize-path": "workspace:*",
    "async": "^3.2.6",
    "tslib": ">=2.7.0"
  },
  "devDependencies": {
    "@faker-js/faker": "9.0.3",
    "@tsed/barrels": "workspace:*",
    "@tsed/core": "workspace:*",
    "@tsed/di": "workspace:*",
    "@tsed/exceptions": "workspace:*",
    "@tsed/logger": "^8.0.0",
    "@tsed/mongoose": "workspace:*",
    "@tsed/platform-http": "workspace:*",
    "@tsed/platform-middlewares": "workspace:*",
    "@tsed/platform-params": "workspace:*",
    "@tsed/platform-response-filter": "workspace:*",
    "@tsed/schema": "workspace:*",
    "@tsed/typescript": "workspace:*",
    "@types/async": "3.2.24",
    "@types/body-parser": "1.19.5",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "^5.0.6",
    "@types/express-session": "1.18.1",
    "@types/lodash": "^4.14.181",
    "@types/method-override": "0.0.35",
    "body-parser": "2.2.1",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "express": "^5.2.1",
    "express-session": "1.18.1",
    "formio": "4.7.2",
    "method-override": "3.0.0",
    "mongodb": "^6.9.0",
    "mongoose": "8.9.5",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@tsed/exceptions": ">=8.0.0",
    "@tsed/logger": ">=8.0.0",
    "@tsed/platform-http": ">=8.0.0",
    "@tsed/platform-middlewares": ">=8.0.0",
    "@tsed/platform-params": ">=8.0.0",
    "@tsed/platform-response-filter": ">=8.0.0",
    "@tsed/schema": ">=8.0.0",
    "express": ">=4.17.1",
    "formio": ">=2.0.0",
    "lodash": "^4.17.21",
    "mongodb": "*",
    "mongoose": ">=8.7.0"
  },
  "peerDependenciesMeta": {
    "@tsed/platform-http": {
      "optional": false
    }
  }
}
