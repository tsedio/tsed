{
  "extends": "@tsed/typescript/tsconfig.node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "./lib/esm",
    "declarationDir": "./lib/types",
    "declaration": true,
    "composite": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "test", "lib", "coverage", "**/*.spec.ts"]
}
