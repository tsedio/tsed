{
  "name": "@tsed/platform-fulmine",
  "version": "8.17.0",
  "description": "A TypeScript Framework on top of fulmine.js, the Express 5 API on uWebSockets.js",
  "keywords": [
    "Controller",
    "Decorator",
    "Express",
    "Inject",
    "TypeScript",
    "api",
    "decorator",
