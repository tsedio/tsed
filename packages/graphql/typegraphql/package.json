{
  "name": "@tsed/typegraphql",
  "version": "8.17.0",
  "description": "TypeGraphQL package for Ts.ED framework, based on Apollo-server-core and Type-graphql",
  "source": "./src/index.ts",
  "type": "module",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "tsed-source": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run barrels && pnpm run build:ts",
    "barrels": "barrels",
    "start:express": "ts-node test/app/index.express.ts",
    "start:koa": "ts-node test/app/index.koa.ts",
    "test": "vitest run",
    "build:ts": "tsc --build tsconfig.esm.json",
    "test:ci": "vitest run --coverage.thresholds.autoUpdate=true"
  },
  "dependencies": {
    "@tsed/apollo": "workspace:*",
    "tslib": ">=2.7.0"
  },
  "devDependencies": {
    "@graphql-yoga/subscription": "5.0.1",
    "@koa/cors": "5.0.0",
    "@tsed/barrels": "workspace:*",
    "@tsed/core": "workspace:*",
    "@tsed/di": "workspace:*",
    "@tsed/logger": "^8.0.0",
    "@tsed/platform-express": "workspace:*",
    "@tsed/platform-http": "workspace:*",
    "@tsed/typescript": "workspace:*",
    "@types/body-parser": "1.19.5",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "^2.8.12",
    "@types/express-session": "1.18.1",
    "@types/koa-bodyparser": "4.3.12",
    "@types/koa-compress": "4.0.6",
    "@types/koa-session": "6.4.5",
    "@types/method-override": "0.0.35",
    "body-parser": "2.4.0",
    "class-validator": "~0.14.1",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "cross-env": "^7.0.3",
    "express-session": "1.18.1",
    "graphql": "16.12.0",
    "graphql-passport": "^0.6.8",
    "graphql-scalars": "2.0.1",
    "graphql-tag": "^2.12.6",
    "koa-bodyparser": "4.4.1",
    "koa-compress": "5.1.1",
    "koa-override": "4.0.0",
    "koa-session": "6.4.0",
    "method-override": "3.0.0",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "type-graphql": ">=2.0.0-rc.2",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@apollo/datasource-rest": ">=6.2.2",
    "@tsed/di": ">=8.0.0",
    "class-validator": ">=0.13.1",
    "graphql": ">=16.0.0",
    "graphql-scalars": ">=1.23.0",
    "type-graphql": ">=2.0.0-rc.2"
  }
}
