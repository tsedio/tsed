{
  "name": "@tsed/prisma",
  "version": "8.17.0",
  "description": "Generate Ts.ED JsonSchema based on Prisma models",
  "keywords": [
    "JsonSchema",
    "TypeScript",
    "class",
    "classes",
    "decorators",
    "json schema",
    "models",
    "prisma",
    "tsed"
  ],
  "bin": {
    "tsed-prisma": "lib/esm/generator.js",
    "tsed-prisma-esm": "lib/esm/generator.js"
  },
  "source": "./src/index.ts",
  "type": "module",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "tsed-source": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "scripts": {
    "prebuild": "cd ../../core && yarn build",
    "build": "rm -rf lib && yarn build:ts && monorepo build-hybrid",
    "build:ts": "tsc --build tsconfig.esm.json",
    "test": "vitest run",
    "generate:enums": "yarn build && cd test/enums && DATABASE_URL=postgres://localhost:8000/db prisma generate",
    "generate:postgres:esm": "yarn build && cd test/postgres-esm && DATABASE_URL=postgres://localhost:8000/db prisma generate",
    "generate:mongo:esm": "yarn build && cd test/mongo-esm && DATABASE_URL=postgres://localhost:8000/db prisma generate",
    "generate:circular:esm": "yarn build && cd test/circular-ref && DATABASE_URL=postgres://localhost:8000/db prisma generate",
    "test:ci": "vitest run --coverage.thresholds.autoUpdate=true"
  },
  "dependencies": {
    "@prisma/generator-helper": "^7.3.0",
    "@prisma/internals": "^7.3.0",
    "change-case": "^5.4.4",
    "fs-extra": "^11.2.0",
    "pluralize": "^8.0.0",
    "ts-morph": "^12.2.0",
    "tslib": ">=2.7.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.3.0",
    "@tsed/barrels": "workspace:*",
    "@tsed/core": "workspace:*",
    "@tsed/di": "workspace:*",
    "@tsed/json-mapper": "workspace:*",
    "@tsed/monorepo-utils": "2.3.13",
    "@tsed/schema": "workspace:*",
    "@tsed/typescript": "workspace:*",
    "@types/change-case": "^2.3.1",
    "@types/pluralize": "0.0.33",
    "prisma": "^7.3.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@prisma/client": ">=6.0.0",
    "@tsed/core": ">=8.0.0",
    "@tsed/di": ">=8.0.0",
    "@tsed/json-mapper": ">=8.0.0",
    "@tsed/schema": ">=8.0.0"
  }
}
