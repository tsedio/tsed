{
  "name": "@tsed/scalar",
  "version": "8.17.0",
  "description": "Scalar package for Ts.ED framework",
  "source": "./src/index.ts",
  "type": "module",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "tsed-source": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "pnpm run clean && pnpm run barrels &&  pnpm run build:ts && pnpm run copy:views",
    "copy:views": "cp -r ./views ./lib/views",
    "barrels": "barrels",
    "test": "vitest run",
    "start": "node --import @swc-node/register/esm-register test/app/index.ts",
    "build:ts": "tsc --build tsconfig.esm.json",
    "test:ci": "vitest run --coverage.thresholds.autoUpdate=true"
  },
  "dependencies": {
    "@scalar/types": "^0.0.23",
    "@tsed/normalize-path": "workspace:*",
    "@tsed/openapi-utils": "workspace:*",
    "@tsed/openspec": "workspace:*",
    "tslib": ">=2.7.0"
  },
  "devDependencies": {
    "@tsed/barrels": "workspace:*",
    "@tsed/core": "workspace:*",
    "@tsed/di": "workspace:*",
    "@tsed/json-mapper": "workspace:*",
    "@tsed/logger": "^8.0.0",
    "@tsed/openspec": "workspace:*",
    "@tsed/platform-http": "workspace:*",
    "@tsed/platform-router": "workspace:*",
    "@tsed/schema": "workspace:*",
    "@tsed/swagger": "workspace:*",
    "@tsed/typescript": "workspace:*",
    "@types/body-parser": "1.19.5",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/method-override": "0.0.35",
    "body-parser": "2.4.0",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "method-override": "3.0.0",
    "supertest": "7.0.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@tsed/platform-http": ">=8.0.0",
    "@tsed/platform-router": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@tsed/platform-http": {
      "optional": false
    }
  }
}
