{
  "name": "@tsed/benchmarks",
  "version": "8.17.0",
  "private": true,
  "description": "HTTP benchmarks of a Ts.ED server across versions (Express, Koa, Fastify, fulmine.js)",
  "type": "module",
  "scripts": {
    "bench": "node ./src/cli.mjs",
    "bench:publish": "node ./src/publish.mjs",
    "bench:app": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tsed/ajv": "workspace:*",
    "@tsed/core": "workspace:*",
    "@tsed/di": "workspace:*",
    "@tsed/json-mapper": "workspace:*",
    "@tsed/platform-express": "workspace:*",
    "@tsed/platform-fastify": "workspace:*",
    "@tsed/platform-fulmine": "workspace:*",
    "@tsed/platform-http": "workspace:*",
    "@tsed/platform-koa": "workspace:*",
    "@tsed/platform-params": "workspace:*",
    "@tsed/schema": "workspace:*",
    "@types/node": "^24.0.0",
    "autocannon": "8.0.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  }
}
